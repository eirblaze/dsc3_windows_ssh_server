{
  "resources": [
    {
      "resource": "Microsoft.Windows/OptionalFeatureList",
      "input": {
        "features": [
          {
            "featureName": "OpenSSH.Server",
            "state": "Installed"
          }
        ]
      }
    },
    {
      "resource": "Microsoft.Windows/Service",
      "input": {
        "name": "sshd",
        "startType": "Automatic",
        "status": "Running"
      }
    },
    {
      "resource": "Microsoft.Windows/FirewallRuleList",
      "input": {
        "Rules": [
          {
            "ruleName": "OpenSSH-Server-In-TCP",
            "direction": "Inbound",
            "protocol": "TCP",
            "localPort": "22",
            "action": "Allow",
            "state": "Enabled"
          }
        ]
      }
    }
  ]
}

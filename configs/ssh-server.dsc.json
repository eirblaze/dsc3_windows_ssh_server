{
  "resources": [

    {
      "resource": "Microsoft.Windows/Service",
      "input": {
        "name": "sshd",
        "startType": "Automatic",
        "status": "Running"
      }
    },
    {
      "resource": "Microsoft.Windows/FirewallRuleList",
      "input": {
        "rules": [
          {
            "name": "OpenSSH-Server-In-TCP",
            "direction": "Inbound",
            "protocol": 6,
            "localPorts": "22",
            "action": "Allow",
            "enabled": true,
            "profiles": ["Domain", "Private", "Public"]
          }
        ]
      }
    }
  ]
}

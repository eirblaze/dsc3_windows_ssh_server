{
  "resources": [
    {
      "resource": "Microsoft.Windows/OptionalFeatureList",
      "input": {
        "Features": [
          {
            "Name": "OpenSSH.Server",
            "Ensure": "Present"
          }
        ]
      }
    },
    {
      "resource": "Microsoft.Windows/Service",
      "input": {
        "Name": "sshd",
        "StartupType": "Automatic",
        "State": "Running"
      }
    },
    {
      "resource": "Microsoft.Windows/FirewallRuleList",
      "input": {
        "Rules": [
          {
            "Name": "OpenSSH-Server-In-TCP",
            "Ensure": "Present"
          }
        ]
      }
    }
  ]
}
